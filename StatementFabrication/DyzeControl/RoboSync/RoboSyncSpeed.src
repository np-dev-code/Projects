&ACCESS RVP
&REL 11
GLOBAL DEFFCT INT RoboSyncSpeed(fi_rRobotSpeed:IN)

REAL fi_rRobotSpeed
REAL _rVolPerMM, _rSpeed,_rVolPerSec, _rRevsPerMM,_rVolPerRev
INT _nSpeed

;Robot speed is passed in as m/sec, converted to mm/s by *1000
_rVolPerSec = rLayerHeight*rLayerWidth*(fi_rRobotSpeed*1000)

_rRevsPerMM = rStepsPerMM / rStepsPerRev
_rVolPerMM = PI * (rFilamentOD*rFilamentOD)/4
_rVolPerRev =  _rVolPerMM/_rRevsPerMM

; The 240 is 60 to convert rps to rpm, *4 to turn rpm into
;the JOG register unit of 0.25 RPM (RoboSync Hub guide, Set jogging
;speed), as these are constant the calculation is done offline 60*4=240
_rSpeed = rExtrusionConstant*(240*_rVolPerSec/_rVolPerRev)

;Clamp to the positive range of the 16 bit jog speed register
IF _rSpeed > 32767 THEN
   _rSpeed = 32767
ENDIF
IF _rSpeed < 0 THEN
   _rSpeed = 0
ENDIF

_nSpeed = _rSpeed ;REAL to INT assignment rounds to nearest

RETURN _nSpeed

ENDFCT

