&ACCESS RVO2
&REL 7
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF RoboSyncInterrupt( )
;************************************************
;     NextState Automation Ltd
;     www.nextstateautomation.co.uk
;************************************************
;     Contact: helpdesk@nextstateautomation.co.uk
;     Date: 14/09/26
;     Version: 0.1.1
;************************************************

BRAKE

;Only restore temperatures if the heater timeout switched them off
IF bTemperatureSave THEN
   SetTemperature(#HEATED_BED, SaveTemperature[1])
   SetTemperature(#EXTRUDER0,SaveTemperature[2])
   SetTemperature(#EXTRUDER1,SaveTemperature[3])
   SetTemperature(#NOZZLE,SaveTemperature[4])
   bTemperatureSave = FALSE
ENDIF

WaitForExtruderTemps()


IF StepperError() THEN 
   bResetStepper = TRUE
ENDIF 

;Stepper only restarts if extruding, otherwise it is expected to stay stopped
WAIT FOR (stepperState==#RUNNING) OR ((stepperState==#STOPPED) AND NOT bExtrude)


bRoboSyncInterrupt = FALSE

END
