&ACCESS RVO
&REL 237
&COMMENT Ansteuerung Micromaster Frequenzumrichter
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\ExpertSubmit
&PARAM DISKPATH = KRC:\R1\TP\CNCRobotics\CEAD
DEF RoboSyncSps(   )
;************************************************
;     NextState Automation Ltd
;     www.nextstateautomation.co.uk
;************************************************
;     Contact: helpdesk@nextstateautomation.co.uk
;     Date: 14/09/26
;     Version: 0.1.1
;     Module : RoboSyncSps
;     Purpose: Background logic, call from sps.sub: error stop, stepper
;              state machine, heater idle timeout, program state handling
;************************************************

DECL STATE_T E_stat
DECL MODUS_T E_mode


;One of the outputs is used to determine if the system 
;is just booting up, set straight away so we can initialise
;any variables here
IF oStartUpFlag == FALSE THEN
  stepperState = #DISABLED 
  oStartUpFlag = TRUE
ENDIF



;STOP IF anything is in error

bStepperError = StepperError() OR bTimeoutError
bPidError = PidError(#EXTRUDER0) OR PidError(#EXTRUDER1)

;If it is in error it will continually stop the program
;won't allow it continue with an error
IF (bPidError OR bStepperError) THEN
      CWRITE($CMD,E_stat,E_mode,"STOP 1")
ENDIF



bProcessing = TRUE
IF bSpsControl == TRUE THEN

IF ((stepperState<>#DISABLED) AND (bStepperError)) THEN
 StepperOpcode(STOP_JOGGING)
 stepperState = #ERROR 
ENDIF

SWITCH stepperState
   
   CASE #DISABLED 
      IF bEnableStepper THEN
         stepperState = #RESET
      ENDIF     
   CASE #RESET
      bResetStepper = FALSE
      StepperOpcode(RESET_ALARM_CODE)
      
      stepperState = #RESETTING
      StartStepperTimer()  
      
   CASE #RESETTING
     IF (stepper_fault==FALSE) THEN
         StepperOpcode(ENABLE_DRIVE)
         StartStepperTimer()
         stepperState = #ENABLED 
      ENDIF
      IF $TIMER_FLAG[STEPPER_TIMER] THEN
         StepperOpcode(STOP_JOGGING)
         stepperState = #ERROR 
         bTimeoutError = TRUE
      ENDIF
      
   CASE #ENABLED
      IF stepper_enabled THEN
         $TIMER_STOP[STEPPER_TIMER]=TRUE
         stepperState = #STOPPED
      ELSE
           IF $TIMER_FLAG[STEPPER_TIMER] THEN
              StepperOpcode(STOP_JOGGING)
              stepperState = #ERROR 
              bTimeoutError = TRUE
           ENDIF
      ENDIF

   CASE #STARTING
      ;Jog speed was written on entry, give it time to reach the drive
      ;before commencing jogging
      IF stepper_jogging THEN
           stepperState = #RUNNING
      ENDIF      
      
      IF bEnableStepper AND bExtrude AND NOT(bOverrideStepper) THEN
         IF $TIMER_FLAG[STEPPER_TIMER] THEN
            StepperOpcode(STOP_JOGGING)
            stepperState = #ERROR 
            bTimeoutError = TRUE
           
         ENDIF
       ELSE
         StepperOpcode(STOP_JOGGING)         
         StartStepperTimer()
         stepperState = #STOPPING
      ENDIF

   CASE #RUNNING
      
       IF bExtrude AND NOT(bOverrideStepper) THEN

          stepperSpeed = CalcStepperSpeed()
              
          IF stepperSpeed <> prevStepperSpeed THEN
            stepper_jogSpeed = stepperSpeed  
          ENDIF
          prevStepperSpeed = stepperSpeed
       
       ELSE
       
         IF NOT (bOverrideStepper) AND bEnableRetract THEN
             stepper_jogSpeed = ToUnsigned16(-nRetractSpeed)
             prevStepperSpeed = 0 ;Force extrude speed to be rewritten
             $TIMER[RETRACT_TIMER]=-nRetractTime
             $TIMER_STOP[RETRACT_TIMER]=FALSE
             
             ;Keep jogging in reverse for nRetractTime, RETRACT then stops
             stepperState = #RETRACT
          ELSE   
             StepperOpcode(STOP_JOGGING)         
             StartStepperTimer()
             stepperState = #STOPPING
         ENDIF
       ENDIF      
       
       IF(bEnableStepper==FALSE)THEN
           StepperOpcode(STOP_JOGGING)         
           StartStepperTimer()
           stepperState = #STOPPING
       ENDIF
        
   CASE #RETRACT
      IF $TIMER_FLAG[RETRACT_TIMER] THEN
         $TIMER_STOP[RETRACT_TIMER]=TRUE
         
         StepperOpcode(STOP_JOGGING)         
         StartStepperTimer()
         stepperState = #STOPPING
      ENDIF

   CASE #STOPPING
      ;Timeout on STEPPER_TIMER (started on entry). RETRACT_TIMER can't
      ;be used here: its flag stays TRUE after a retract has finished
      IF NOT(stepper_stopping) AND NOT(stepper_moving) THEN
         $TIMER_STOP[STEPPER_TIMER]=TRUE
         stepperState = #STOPPED
      ELSE
         IF $TIMER_FLAG[STEPPER_TIMER] THEN
            StepperOpcode(STOP_JOGGING)
            stepperState = #ERROR
            bTimeoutError = TRUE
         ENDIF
      ENDIF
   
   CASE #STOPPED
      IF bEnableStepper AND bExtrude AND NOT(bOverrideStepper) THEN
         ;Set the jog speed to zero, the speed will be set when running
         stepper_jogSpeed = 0
         prevStepperSpeed = 0
         
         StepperOpcode(COMMENCE_JOGGING)
         StartStepperTimer()
         stepperState = #STARTING
      ENDIF
      
      IF NOT bEnableStepper THEN
         StepperOpcode(DISABLE_DRIVE)
         StartStepperTimer()
         stepperState = #DISABLING
      ENDIF
   CASE #DISABLING
      IF (stepper_enabled == FALSE) THEN
         stepperState = #DISABLED
      ENDIF
       IF $TIMER_FLAG[STEPPER_TIMER] THEN
         stepperState = #ERROR 
         bTimeoutError = TRUE
      ENDIF


   CASE #ERROR
      ;Disable the drive once, after the stop command has had time to act.
      ;The stopped timer marks that the disable has been sent.
      IF ($TIMER_STOP[STEPPER_TIMER]==FALSE) THEN
         $TIMER_STOP[STEPPER_TIMER]=TRUE
      ENDIF
      IF NOT (stepper_moving) and stepper_enabled THEN
            StepperOpcode(DISABLE_DRIVE)
      ENDIF
      IF bResetStepper THEN
         stepperState = #RESET
      ENDIF
ENDSWITCH

ENDIF
      
bProcessing = FALSE

IF ($PRO_STATE1 == #P_FREE) OR ($PRO_STATE1 == #P_RESET) THEN
      bOverrideStepper = TRUE
      bRoboSyncInterrupt = FALSE
      bTemperatureSave = FALSE
ENDIF

IF ($PRO_STATE1 <> #P_FREE) THEN
	IF ($PRO_STATE1 <> #P_ACTIVE) THEN  ;If program is not active
		
		IF ($TIMER_STOP[HEATER_TIMER] == TRUE)THEN
		$TIMER_STOP[HEATER_TIMER] = FALSE
      ENDIF
		IF ($PRO_STATE1 == #P_STOP) THEN
			bOverrideStepper = TRUE ;Stop extruding while the program is stopped
			bRoboSyncInterrupt = TRUE
		ENDIF
	ELSE
		bOverrideStepper = FALSE   

		$TIMER_STOP[HEATER_TIMER] = TRUE
		$TIMER_FLAG[HEATER_TIMER] = FALSE
		$TIMER[HEATER_TIMER] = -nHeaterTimeout
		ENDIF
ELSE
   $TIMER_STOP[HEATER_TIMER] = FALSE
ENDIF
	
;If the program has been stopped for the heater_timer, e.g. 10 minutes then 
;Set points will be zero'ed, so they do not sit cooking the system
;particularly important customer wants to leave the system unattended for
;any period of time
IF $TIMER_FLAG[HEATER_TIMER] THEN
   IF (bTemperatureSave == FALSE) THEN
      
      SaveTemperature[1] = GetSetTemperature(#HEATED_BED)
      SaveTemperature[2] = GetSetTemperature(#EXTRUDER0)
      SaveTemperature[3] = GetSetTemperature(#EXTRUDER1)
      SaveTemperature[4] = GetSetTemperature(#NOZZLE)
      bTemperatureSave = TRUE
      
      PidSetPoint(#HEATED_BED,0 )
      PidSetPoint(#EXTRUDER0,0 )
      PidSetPoint(#EXTRUDER1,0 )
      PidSetPoint(#NOZZLE,0 )
            
      $TIMER_STOP[HEATER_TIMER] = TRUE
      $TIMER_FLAG[HEATER_TIMER] = FALSE
      $TIMER[HEATER_TIMER] = -nHeaterTimeout
   ENDIF
ENDIF
		

END


DEF StartStepperTimer()
;------------------------------------------------
; Name    : StartStepperTimer
; Purpose : Restart STEPPER_TIMER, $TIMER_FLAG goes TRUE after nStepperTimeout
; Params  : -
; Returns : -
;------------------------------------------------
;Restart the stepper timer, $TIMER_FLAG goes TRUE after fi_nTime ms

 $TIMER[STEPPER_TIMER]=-nStepperTimeout
 $TIMER_STOP[STEPPER_TIMER]=FALSE
 bTimeoutError = FALSE

END


DEFFCT INT CalcStepperSpeed()
;------------------------------------------------
; Name    : CalcStepperSpeed
; Purpose : Extruder jog speed for the current robot speed
; Params  : -
; Returns : INT, jog speed register value
; Notes   : Uses the programmed $VEL.CP when the robot is stationary so
;           purging in place still extrudes
;------------------------------------------------
;Extruder jog speed for the current robot speed, uses the programmed
;speed when stationary so purging in place still extrudes
IF bFixedExtrusion THEN
   RETURN nFixedSpeed
ENDIF

IF $VEL_ACT < 0.001 THEN
   RETURN RoboSyncSpeed($VEL.CP)
ELSE
  RETURN RoboSyncSpeed($VEL_ACT)
ENDIF

ENDFCT
