GLOBAL DEF WarningMsg(fin_CNCRMsg:OUT, fin_nGroupNo:IN )
;------------------------------------------------
; Name    : WarningMsg
; Purpose : Show a notify message once, until it is cleared
; Params  : fin_CNCRMsg  (OUT) RSYNC_MSG_T : message, bDisplayFlag is updated
;           fin_nGroupNo (IN)  INT         : message number offset
; Returns : -
; Notes   : Message number is fin_nGroupNo + nNo
;------------------------------------------------

DECL RSYNC_MSG_T fin_CNCRMsg
DECL INT fin_nGroupNo
 
IF fin_CNCRMsg.bDisplayFlag==FALSE THEN
   
   MsgNotify(fin_CNCRMsg.strMsg[], fin_CNCRMsg.strName[],,,fin_nGroupNo + fin_CNCRMsg.nNo, E_progNotifyMsgOpt)   
   fin_CNCRMsg.bDisplayFlag=TRUE 
ENDIF 
   
END

GLOBAL DEF DisplayMsg(fin_CNCRMsg:OUT, fin_nGroupNo:IN )
;------------------------------------------------
; Name    : DisplayMsg
; Purpose : Show a notify message every time it is called
; Params  : fin_CNCRMsg  (OUT) RSYNC_MSG_T : message
;           fin_nGroupNo (IN)  INT         : message number offset
; Returns : -
;------------------------------------------------

DECL RSYNC_MSG_T fin_CNCRMsg
DECL INT fin_nGroupNo
 
   MsgNotify(fin_CNCRMsg.strMsg[], fin_CNCRMsg.strName[],,,fin_nGroupNo + fin_CNCRMsg.nNo, E_progNotifyMsgOpt)   
   
END

GLOBAL DEF WarningClear(fin_CNCRMsg:OUT )
;------------------------------------------------
; Name    : WarningClear
; Purpose : Re-arm a message so WarningMsg shows it again
; Params  : fin_CNCRMsg  (OUT) RSYNC_MSG_T : message, bDisplayFlag is cleared
; Returns : -
;------------------------------------------------

DECL RSYNC_MSG_T fin_CNCRMsg
 
fin_CNCRMsg.bDisplayFlag= FALSE 

END

GLOBAL DEF CheckWarningMsg(bCondition:IN, fin_CNCRMsg:OUT, fin_nGroupNo:IN )
;------------------------------------------------
; Name    : CheckWarningMsg
; Purpose : Show a message once while a condition is TRUE, re-arm it
;           when the condition clears
; Params  : bCondition   (IN)  BOOL        : alarm condition, e.g. an alarm bit
;           fin_CNCRMsg  (OUT) RSYNC_MSG_T : message, bDisplayFlag is updated
;           fin_nGroupNo (IN)  INT         : message number offset
; Returns : -
;------------------------------------------------

DECL RSYNC_MSG_T fin_CNCRMsg
DECL INT fin_nGroupNo
DECL BOOL bCondition
 
IF bCondition==TRUE THEN
   WarningMsg(fin_CNCRMsg,fin_nGroupNo)
ELSE
   WarningClear(fin_CNCRMsg)   
   
ENDIF 
   
END

