GLOBAL DEFFCT INT GetPidKi (fi_pidType:IN)
;------------------------------------------------
; Name    : GetPidKi
; Purpose : Read the integral rate Ir (Ki) reported by the controller
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
; Returns : INT, 0..3000 = 0.00..30.00 rep/min
; Notes   : Only valid while autotune is not running
;------------------------------------------------
DECL REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType

SWITCH fi_pidType

CASE #HEATED_BED
 return pid0_Ki
CASE #EXTRUDER0 
 return pid1_Ki
CASE #EXTRUDER1 
 return pid2_Ki
CASE #NOZZLE 
 return pid3_Ki
DEFAULT 
   return 0

ENDSWITCH

ENDFCT

GLOBAL DEF SetAlarmLimit (fi_pidType:IN, fi_temp:IN)
;------------------------------------------------
; Name    : SetAlarmLimit
; Purpose : Write the alarm high limit
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
;           fi_temp    (IN) REAL          : limit, degC
; Returns : -
;------------------------------------------------
DECL REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType
DECL INT _nVal

_nVal =  fi_temp*10


SWITCH fi_pidType

CASE #HEATED_BED
 pid0_SetAlarm = _nVal
CASE #EXTRUDER0 
 pid1_SetAlarm = _nVal
CASE #EXTRUDER1 
 pid2_SetAlarm = _nVal
CASE #NOZZLE 
 pid3_SetAlarm = _nVal
DEFAULT 
 

ENDSWITCH

END

GLOBAL DEFFCT REAL GetAlarmLimit (fi_pidType:IN)
;------------------------------------------------
; Name    : GetAlarmLimit
; Purpose : Read the alarm high limit reported by the controller
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
; Returns : REAL, degC
;------------------------------------------------
DECL REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType

SWITCH fi_pidType

CASE #HEATED_BED
 return pid0_AlarmLimit/10.0
CASE #EXTRUDER0 
 return pid1_AlarmLimit/10.0
CASE #EXTRUDER1 
 return pid2_AlarmLimit/10.0
CASE #NOZZLE 
 return pid3_AlarmLimit/10.0
DEFAULT 
   return 0.0

ENDSWITCH

ENDFCT

GLOBAL DEF SetAutotune(fi_pidType:IN,fi_nType:IN)
;------------------------------------------------
; Name    : SetAutotune
; Purpose : Send an autotune command
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
;           fi_nType   (IN) INT           : AUTOTUNE_STOP, AUTOTUNE_FAST
;                                           or AUTOTUNE_FULL
; Returns : -
;------------------------------------------------
DECL INT fi_nType
DECL ENUM_PID_TYPE fi_pidType

SWITCH fi_pidType

CASE #HEATED_BED
  pid0_Autotune = fi_nType
CASE #EXTRUDER0 
  pid1_Autotune = fi_nType
CASE #EXTRUDER1 
  pid2_Autotune = fi_nType
CASE #NOZZLE 
  pid3_Autotune = fi_nType
DEFAULT 

ENDSWITCH

END

GLOBAL DEFFCT BOOL GetAutotuneBit(fi_pidType:IN)
;------------------------------------------------
; Name    : GetAutotuneBit
; Purpose : Read the controller autotune status bit
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
; Returns : BOOL, TRUE while autotune is running
;------------------------------------------------
DECL ENUM_PID_TYPE fi_pidType

SWITCH fi_pidType

CASE #HEATED_BED
  return pid0_AutoTuneBit
CASE #EXTRUDER0 
  return pid1_AutoTuneBit
CASE #EXTRUDER1
  return pid2_AutoTuneBit
CASE #NOZZLE 
  return pid3_AutoTuneBit
DEFAULT 
   return FALSE

ENDSWITCH

ENDFCT

GLOBAL DEF SetPidKi (fi_pidType:IN, fi_nVal:IN)
;------------------------------------------------
; Name    : SetPidKi
; Purpose : Write the integral rate Ir (Ki)
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
;           fi_nVal    (IN) INT           : 0..3000 = 0.00..30.00 rep/min
; Returns : -
; Notes   : Autotune must not be running
;------------------------------------------------
DECL INT fi_nVal
DECL ENUM_PID_TYPE fi_pidType
DECL INT nVal

SWITCH fi_pidType

CASE #HEATED_BED
   pid0_SetKi = fi_nVal
CASE #EXTRUDER0 
   pid1_SetKi = fi_nVal
CASE #EXTRUDER1 
   pid2_SetKi = fi_nVal
CASE #NOZZLE 
   pid3_SetKi = fi_nVal
DEFAULT 

ENDSWITCH

END

GLOBAL DEF SetTemperature (fi_pidType:IN,fi_temp:IN)
;------------------------------------------------
; Name    : SetTemperature
; Purpose : Set the temperature setpoint, widening the setpoint limits first
;           if the new setpoint is outside them
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
;           fi_temp    (IN) REAL          : setpoint, degC
; Returns : -
; Notes   : Low limit becomes fi_temp*pidDefaultLowerLimit, high limit
;           fi_temp*pidDefaultUpperLimit. Limits are only ever widened
;------------------------------------------------
REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType
INT _nVal

_nVal = fi_temp*10

IF fi_temp < GetLowerTemperature(fi_pidType) THEN
SetLowerTemperature(fi_pidType ,fi_temp * pidDefaultLowerLimit)
ENDIF

IF fi_temp > GetUpperTemperature(fi_pidType)  THEN
   SetUpperTemperature(fi_pidType, fi_temp * pidDefaultUpperLimit )
ENDIF

PidSetPoint(fi_pidType,fi_temp)

END

GLOBAL DEFFCT REAL GetSetTemperature (fi_pidType:IN)
;------------------------------------------------
; Name    : GetSetTemperature
; Purpose : Read the commanded temperature setpoint
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
; Returns : REAL, degC
; Notes   : Reads back the robot output word, not the controller
;------------------------------------------------
REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType
INT _nVal

SWITCH fi_pidType

CASE #HEATED_BED
 return pid0_SetPoint/10.0
CASE #EXTRUDER0 
 return pid1_SetPoint/10.0
CASE #EXTRUDER1 
 return pid2_SetPoint/10.0
CASE #NOZZLE 
 return pid3_SetPoint/10.0
DEFAULT 
   return 0.0

ENDSWITCH
ENDFCT

GLOBAL DEF AutoTuneProcess(fi_pidType:IN,fi_temp:IN,fi_fast:IN)
;------------------------------------------------
; Name    : AutoTuneProcess
; Purpose : Run a complete autotune on one PID channel and wait for it
;           to finish
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
;           fi_temp    (IN) REAL          : autotune setpoint, degC
;           fi_fast    (IN) INT           : AUTOTUNE_FAST or AUTOTUNE_FULL
; Returns : -
; Notes   : Returns without waiting if autotune does not start within
;           nAutotuneStartTimeout. No timeout on autotune completion.
;           Hub guide: tune with other heaters off, in the order
;           bed, top, bottom, nozzle. Robot interpreter only (WAIT)
;------------------------------------------------

REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType
INT fi_fast, _nVal


SetAutotune(fi_pidType,AUTOTUNE_STOP)
WAIT SEC 1

SetTemperature(fi_pidType,fi_temp)
WAIT SEC 1
SetAutoTune(fi_pidType,fi_fast)

;Wait for the controller to report autotune has started, then for it to finish
$TIMER[AUTOTUNE_TIMER] = -nAutotuneStartTimeout
$TIMER_STOP[AUTOTUNE_TIMER] = FALSE
WAIT FOR GetAutotuneBit(fi_pidType) OR $TIMER_FLAG[AUTOTUNE_TIMER]
$TIMER_STOP[AUTOTUNE_TIMER] = TRUE

IF GetAutotuneBit(fi_pidType) THEN
   WAIT FOR GetAutotuneBit(fi_pidType) == FALSE
ENDIF

END

GLOBAL DEF SetExtruderHeatZones (fi_Temp1:IN, fi_Temp2:IN)
;------------------------------------------------
; Name    : SetExtruderHeatZones
; Purpose : Set both extruder heat zone temperatures
; Params  : fi_Temp1   (IN) REAL : EXTRUDER0 (top) setpoint, degC
;           fi_Temp2   (IN) REAL : EXTRUDER1 (bottom) setpoint, degC
; Returns : -
;------------------------------------------------
REAL fi_Temp1,fi_Temp2

SetTemperature(#EXTRUDER0,fi_Temp1)
SetTemperature(#EXTRUDER1,fi_Temp2)

END

GLOBAL DEF WaitForExtruderTemps()
;------------------------------------------------
; Name    : WaitForExtruderTemps
; Purpose : Wait until EXTRUDER0 and EXTRUDER1 are within
;           rTemperatureTolerance of their setpoints
; Params  : -
; Returns : -
; Notes   : No timeout. Robot interpreter only (WAIT)
;------------------------------------------------

WAIT FOR  CheckAtTemperature(#EXTRUDER0,rTemperatureTolerance) AND CheckAtTemperature(#EXTRUDER1,rTemperatureTolerance)

END

GLOBAL DEFFCT BOOL CheckAtTemperature (fi_pidType:IN,fi_rTol:IN)
;------------------------------------------------
; Name    : CheckAtTemperature
; Purpose : Check whether the measured temperature is within a tolerance
;           of the setpoint
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
;           fi_rTol    (IN) REAL          : tolerance, +/- degC
; Returns : BOOL, TRUE if within tolerance
;------------------------------------------------
REAL fi_rTol
DECL ENUM_PID_TYPE fi_pidType

INT _nTol

_nTol = fi_rTol*10

SWITCH fi_pidType

CASE #HEATED_BED
   IF ( (pid0_temp > (pid0_SetPoint-_nTol)) AND (pid0_temp < (pid0_SetPoint +_nTol)) )THEN
     RETURN TRUE
   ELSE 
      RETURN FALSE
   ENDIF
CASE #EXTRUDER0 
   IF ( (pid1_temp > (pid1_SetPoint-_nTol)) AND (pid1_temp < (pid1_SetPoint +_nTol)) )THEN
      RETURN TRUE
   ELSE 
      RETURN FALSE
   ENDIF
CASE #EXTRUDER1 
 IF ( (pid2_temp > (pid2_SetPoint-_nTol)) AND (pid2_temp < (pid2_SetPoint +_nTol)) )THEN
      RETURN TRUE
   ELSE 
      RETURN FALSE
   ENDIF
CASE #NOZZLE 
 IF ( (pid3_temp > (pid3_SetPoint-_nTol)) AND (pid3_temp < (pid3_SetPoint +_nTol)) )THEN
      RETURN TRUE
   ELSE 
      RETURN FALSE
   ENDIF
DEFAULT 
   RETURN FALSE

ENDSWITCH

ENDFCT

GLOBAL DEFFCT BOOL PidError(fi_pidType:IN)
;------------------------------------------------
; Name    : PidError
; Purpose : Check the controller alarm bits
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
; Returns : BOOL, TRUE if any of alarm 1..4 is active
;------------------------------------------------
DECL ENUM_PID_TYPE fi_pidType

SWITCH fi_pidType
   
CASE #HEATED_BED
  RETURN (pid0_alarm1 OR pid0_alarm2 OR pid0_alarm3 OR pid0_alarm4)
CASE #EXTRUDER0 
  RETURN (pid1_alarm1 OR pid1_alarm2 OR pid1_alarm3 OR pid1_alarm4)
CASE #EXTRUDER1
  RETURN (pid2_alarm1 OR pid2_alarm2 OR pid2_alarm3 OR pid2_alarm4)
CASE #NOZZLE 
  RETURN (pid3_alarm1 OR pid3_alarm2 OR pid3_alarm3 OR pid3_alarm4)
DEFAULT 
   RETURN FALSE

ENDSWITCH

ENDFCT
