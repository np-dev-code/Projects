&ACCESS RVO3
&REL 16
&PARAM DISKPATH = KRC:\R1\TP\CNCRobotics\CEAD
DEF RoboSyncPidControl( )
;************************************************
;     NextState Automation Ltd
;     www.nextstateautomation.co.uk
;************************************************
;     Contact: helpdesk@nextstateautomation.co.uk
;     Date: 14/09/26
;     Version: 0.1.1
;     Module : RoboSyncPidControl
;     Purpose: Temperature, PID gain, autotune and alarm functions for
;              the RoboSync Hub PID controllers 0..3
;************************************************
END

GLOBAL DEFFCT REAL GetLowerTemperature (fi_pidType:IN)
;------------------------------------------------
; Name    : GetLowerTemperature
; Purpose : Read the commanded setpoint low limit (SPLL)
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
; Returns : REAL, degC
; Notes   : Reads back the robot output word, not the controller
;------------------------------------------------
DECL ENUM_PID_TYPE fi_pidType

SWITCH fi_pidType

CASE #HEATED_BED
 return pid0_SetPointLowLimit/10.0
CASE #EXTRUDER0 
 return pid1_SetPointLowLimit/10.0
CASE #EXTRUDER1 
 return pid2_SetPointLowLimit/10.0
CASE #NOZZLE 
 return pid3_SetPointLowLimit/10.0
DEFAULT 
   return 0.0

ENDSWITCH

ENDFCT

GLOBAL DEF SetLowerTemperature (fi_pidType:IN, fi_temp:IN)
;------------------------------------------------
; Name    : SetLowerTemperature
; Purpose : Write the setpoint low limit (SPLL)
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
;           fi_temp    (IN) REAL          : limit, degC
; Returns : -
; Notes   : Controller requires SPLL < SPHL
;------------------------------------------------
DECL REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType
DECL INT nVal

nVal =  fi_temp*10

SWITCH fi_pidType

CASE #HEATED_BED
   pid0_SetPointLowLimit = nVal
CASE #EXTRUDER0 
   pid1_SetPointLowLimit = nVal
CASE #EXTRUDER1 
   pid2_SetPointLowLimit = nVal
CASE #NOZZLE 
   pid3_SetPointLowLimit = nVal
DEFAULT 

ENDSWITCH

END

GLOBAL DEFFCT REAL GetUpperTemperature (fi_pidType:IN)
;------------------------------------------------
; Name    : GetUpperTemperature
; Purpose : Read the commanded setpoint high limit (SPHL)
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
; Returns : REAL, degC
; Notes   : Reads back the robot output word, not the controller
;------------------------------------------------
DECL ENUM_PID_TYPE fi_pidType

SWITCH fi_pidType

CASE #HEATED_BED
 return pid0_SetPointHighLimit/10.0
CASE #EXTRUDER0 
 return pid1_SetPointHighLimit/10.0
CASE #EXTRUDER1 
 return pid2_SetPointHighLimit/10.0
CASE #NOZZLE 
 return pid3_SetPointHighLimit/10.0
DEFAULT 
   return 0.0

ENDSWITCH

ENDFCT

GLOBAL DEF SetUpperTemperature (fi_pidType:IN, fi_temp:IN)
;------------------------------------------------
; Name    : SetUpperTemperature
; Purpose : Write the setpoint high limit (SPHL)
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
;           fi_temp    (IN) REAL          : limit, degC
; Returns : -
; Notes   : Controller requires SPHL > SPLL
;------------------------------------------------
DECL REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType
DECL INT nVal

nVal =  fi_temp*10

SWITCH fi_pidType

CASE #HEATED_BED
   pid0_SetPointHighLimit = nVal
CASE #EXTRUDER0 
   pid1_SetPointHighLimit = nVal
CASE #EXTRUDER1 
   pid2_SetPointHighLimit = nVal
CASE #NOZZLE 
   pid3_SetPointHighLimit = nVal
DEFAULT 

ENDSWITCH

END

GLOBAL DEFFCT REAL GetTemperature (fi_pidType:IN)
;------------------------------------------------
; Name    : GetTemperature
; Purpose : Read the measured temperature
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
; Returns : REAL, degC
;------------------------------------------------

DECL ENUM_PID_TYPE fi_pidType


SWITCH fi_pidType

CASE #HEATED_BED
 return pid0_temp/10.0
CASE #EXTRUDER0 
 return pid1_temp/10.0
CASE #EXTRUDER1 
 return pid2_temp/10.0
CASE #NOZZLE 
 return pid3_temp/10.0
DEFAULT 
   return 0.0

ENDSWITCH

ENDFCT

GLOBAL DEF PidSetPoint(fi_pidType:IN, fi_temp:IN)
;------------------------------------------------
; Name    : PidSetPoint
; Purpose : Write the temperature setpoint, limits are not changed
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
;           fi_temp    (IN) REAL          : setpoint, degC
; Returns : -
; Notes   : Controller rejects a setpoint outside SPLL..SPHL,
;           use SetTemperature to widen the limits as needed
;------------------------------------------------
DECL REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType
DECL INT nVal

nVal =  fi_temp*10

SWITCH fi_pidType

CASE #HEATED_BED
   pid0_SetPoint = nVal
CASE #EXTRUDER0 
   pid1_SetPoint = nVal
CASE #EXTRUDER1 
   pid2_SetPoint = nVal
CASE #NOZZLE 
   pid3_SetPoint = nVal
DEFAULT 

ENDSWITCH

END

GLOBAL DEFFCT INT GetPidKp (fi_pidType:IN)
;------------------------------------------------
; Name    : GetPidKp
; Purpose : Read the proportional band Pb (Kp) reported by the controller
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
; Returns : INT, 0..5000 = 0..500.0 %
; Notes   : Only valid while autotune is not running
;------------------------------------------------
DECL REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType

SWITCH fi_pidType

CASE #HEATED_BED
 return pid0_Kp
CASE #EXTRUDER0 
 return pid1_Kp
CASE #EXTRUDER1 
 return pid2_Kp
CASE #NOZZLE 
 return pid3_Kp
DEFAULT 
   return 0

ENDSWITCH

ENDFCT

GLOBAL DEF SetPidKp (fi_pidType:IN, fi_nVal:IN)
;------------------------------------------------
; Name    : SetPidKp
; Purpose : Write the proportional band Pb (Kp)
; Params  : fi_pidType (IN) ENUM_PID_TYPE : PID channel
;           fi_nVal    (IN) INT           : 0..5000 = 0..500.0 %
; Returns : -
; Notes   : Autotune must not be running
;------------------------------------------------
DECL INT fi_nVal
DECL ENUM_PID_TYPE fi_pidType
DECL INT nVal

SWITCH fi_pidType

CASE #HEATED_BED
   pid0_SetKp = fi_nVal
CASE #EXTRUDER0 
   pid1_SetKp = fi_nVal
CASE #EXTRUDER1 
   pid2_SetKp = fi_nVal
CASE #NOZZLE 
   pid3_SetKp = fi_nVal
DEFAULT 

ENDSWITCH

END

