GLOBAL DEFFCT REAL GetLowerTemperature (fi_pidType:IN)
DECL ENUM_PID_TYPE fi_pidType

SWITCH fi_pidType

CASE #HEATED_BED
 return pid0_SetPointLowLimit/10.0
CASE #EXTRUDER0 
 return pid1_SetPointLowLimit/10.0
CASE #EXTRUDER1 
 return pid2_SetPointLowLimit/10.0
CASE #NOZZLE 
 return pid3_SetPointLowLimit/10.0
DEFAULT 
   return 0.0

ENDSWITCH

ENDFCT

GLOBAL DEF SetLowerTemperature (fi_pidType:IN, fi_temp:IN)
DECL REAL fi_temp
DECL ENUM_PID_TYPE fi_pidType
DECL INT nVal

nVal =  fi_temp*10

SWITCH fi_pidType

CASE #HEATED_BED
   pid0_SetPointLowLimit = nVal
CASE #EXTRUDER0 
   pid1_SetPointLowLimit = nVal
CASE #EXTRUDER1 
   pid2_SetPointLowLimit = nVal
CASE #NOZZLE 
   pid3_SetPointLowLimit = nVal
DEFAULT 

ENDSWITCH

END

