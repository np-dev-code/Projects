 ;stepper_AlarmSpare1     
 ;stepper_blankQSegment   
 ;stepper_AlarmSpare2     
ENDFCT

GLOBAL DEFFCT INT ToUnsigned16(fi_nVal:IN)
;Two's complement encoding of a signed value for a 16 bit output
DECL INT fi_nVal

IF fi_nVal < 0 THEN
   RETURN 65536 + fi_nVal
ENDIF
RETURN fi_nVal
ENDFCT

GLOBAL DEFFCT INT Truncate16(n:IN)

DECL INT ofs
DECL INT n, nOut
DECL CHAR buf[4]


ofs=0
cast_to(buf[],ofs,n)

buf[3] = 0
buf[4] = 0

ofs=0
cast_from(buf[],ofs,nOut)

return nOut
ENDFCT

