&ACCESS RVP2
&REL 2
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\CNCR PROGRAM\Robot
DEF HomeRobot( )
DECL E6AXIS RobotHome
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
  ;ENDFOLD (INI)
;************************************************
;              CNC Robotics Ltd
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 05/04/24
;     Version: 0.21.54
;************************************************
; Description: Routine to move the robot home
;************************************************
RobotHome=XHome
RobotHome.E1 = $POS_ACT.E1

SWITCH ToolOnRobot
CASE #SPINDLE
;FOLD PTP HOME Vel=20 % DEFAULT ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=HOME; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=DEFAULT; Kuka.VelocityPtp=20; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=PTP
;ENDFOLD
$BWDSTART = FALSE
PDAT_ACT = PDEFAULT
FDAT_ACT = FHOME
BAS(#PTP_PARAMS, 20.0)
SET_CD_PARAMS (0)
PTP ROBOTHOME
;ENDFOLD
CASE #CEAD
;FOLD PTP HOME Vel=20 % DEFAULT ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=HOME; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=DEFAULT; Kuka.VelocityPtp=20; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=PTP
;ENDFOLD
$BWDSTART = FALSE
PDAT_ACT = PDEFAULT
FDAT_ACT = FHOME
BAS(#PTP_PARAMS, 20.0)
SET_CD_PARAMS (0)
PTP ROBOTHOME
;ENDFOLD
CASE #NONE
;FOLD PTP HOME Vel=20 % DEFAULT ;%{PE}
;FOLD Parameters ;%{h}
;Params IlfProvider=kukaroboter.basistech.inlineforms.movement.old; Kuka.IsGlobalPoint=False; Kuka.PointName=HOME; Kuka.BlendingEnabled=False; Kuka.MoveDataPtpName=DEFAULT; Kuka.VelocityPtp=20; Kuka.CurrentCDSetIndex=0; Kuka.MovementParameterFieldEnabled=True; IlfCommand=PTP
;ENDFOLD
$BWDSTART = FALSE
PDAT_ACT = PDEFAULT
FDAT_ACT = FHOME
BAS(#PTP_PARAMS, 20.0)
SET_CD_PARAMS (0)
PTP ROBOTHOME
;ENDFOLD
ENDSWITCH

bRackSafe = FALSE

MsgNotify("Robot successfully moved to the home position.", "Robot",,, nRobotMsg + 3, E_progNotifyMsgOpt)

END
