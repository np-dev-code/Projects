;************************************************
; Description: Routine to turn off the air knife
;************************************************


END

GLOBAL DEF AirKnifeOn( )

;Turn off signal to air knife
bAirKnife = TRUE 

END

GLOBAL DEF AirKnifeOff( )

;Turn off signal to air knife
bAirKnife = FALSE

END

GLOBAL DEF AirBlast(period:IN,duty:IN,duration:IN)
DECL INT duty
DECL REAL period
DECL REAL duration

AIRBLAST_TIME = -duration * 1000
nAirBlastPeriod = period * 1000
nAirBlastOnTime = ((nAirBlastPeriod * duty) / 100)
AIRBLASTON_TIME = -nAirBlastOnTime

;Turn off signal to air knife
bAirBlastStart = TRUE
bAirBlastComp = FALSE
bAirKnife = TRUE
bAirBlastOn = TRUE

END

GLOBAL DEF PulseAirKnife(fin_rTime:IN)

;Turn off signal to air knife
REAL fin_rTime

AirBlast(500, 1000, fin_rTime)


END
