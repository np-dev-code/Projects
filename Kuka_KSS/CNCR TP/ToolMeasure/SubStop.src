&ACCESS RVO1
&REL 32
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF SubStop( )

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 0.12.46
;************************************************
; Description: Program to register register tool
; length when the mesaure sensor is triggered.
;************************************************

;Stop robot motion
BRAKE

;Recored the height of the Z attach point
rGrossToolLength = $POS_INT.z 

;Stop robot motion and then resume if total length 
;is greater than 0
IF rGrossToolLength > 0 THEN
  BRAKE
  RESUME
ELSE
  LOOP
      MsgQuit("Error, Tool length less than 0mm, exit the program and investigate the issue!", "ToolMeasuring",,,nMeasureMsg + 10, E_progCommonMsgOpt)
      HALT
  ENDLOOP
ENDIF 

RESUME

END
