;************************************************
; Description: Program path for if the measure 
; sensor limit is triggered.
;************************************************

BRAKE

;Stop the program from continuing
LOOP
   MsgQuit("Error, the measure sensor limit has been tripped!", "ToolMeasuring",,,nMeasureMsg + 11, E_progCommonMsgOpt)
   HALT
ENDLOOP

END
