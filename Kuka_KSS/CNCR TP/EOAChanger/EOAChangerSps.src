&ACCESS RV
&REL 157
&COMMENT Ansteuerung Micromaster Frequenzumrichter
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\ExpertSubmit
DEF EOAChangerSps( )

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 12/09/23
;     Version: 0.23.48
;************************************************
; Description: sps control specific for the spindle.
;************************************************
  
IF bToolOnRobot THEN
   oEOANotLock = FALSE
   oEOAUnlock = FALSE
   
   IF (NOT iEOALocked) OR (NOT iAirOk) THEN
      CWRITE($CMD,E_stat,E_mode,"STOP 1")
      IF (NOT bSchunkFailMsg) THEN
         MsgNotify("Program halted until EOA tool is safely locked again.", "Schunk",,, nSchunkMsg + 5, E_progNotifyMsgOpt)
         bSchunkFailMsg = TRUE
      ENDIF
   ELSE
      bSchunkFailMsg = FALSE
   ENDIF
ENDIF

END