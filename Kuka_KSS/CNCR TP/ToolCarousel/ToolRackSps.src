&ACCESS RV
&REL 12
&COMMENT Ansteuerung Micromaster Frequenzumrichter
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\ExpertSubmit
DEF ToolrackSPS( )

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 1.12.46
;************************************************
; Description: sps to control the tool rack.
;************************************************


;SECTION TO ENSURE TOOL RACK HOMES WHEN POWERED ON

;After user has deemed safe the first time the flag will not reset until robot is powered off again

IF (NOT $ALARM_STOP) THEN
    bReqToolRackHome = TRUE
ENDIF

;SECTION TO STOP TOOL RACK WHEN USER IS NOT SAFE 

;When dead mans is released in T1/T2 or operator safety is triggered in AUT/EXT the tool rack will not be able to operate
IF (NOT $USER_SAF)  OR (NOT $ALARM_STOP) THEN
    oToolrackEnable = FALSE
    oToolrackStart = FALSE
ENDIF

IF ($PRO_STATE1 == #P_FREE) THEN
    bRackSafe = FALSE
ENDIF

END