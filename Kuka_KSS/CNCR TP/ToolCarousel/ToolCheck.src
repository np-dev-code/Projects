&ACCESS RVO7
&REL 16
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF ToolCheck( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 1.12.46
;************************************************
; Description: Program to check if spindle holds
; a tool and drops it if necessary
;************************************************

;If no tool is held then exit program

CheckEOATooling(#SPINDLE)


IF (nToolHeld == 0) THEN
   MsgNotify("No tool is present in the spindle.", "AutoToolChange",,, nAutoToolChangeMsg+6, E_progNotifyMsgOpt)
   RETURN
ENDIF

MsgNotify("Held tool must will be dropped before new tool is collected.", "AutoToolChange",,, nAutoToolChangeMsg+7, E_progNotifyMsgOpt)
ToolrackMove (nToolHeld) ;Call tool changer to position for drop
ToolRackOpen()		 	 ;Close tool rack
ToolDrop ()              ;Run tool drop program

END