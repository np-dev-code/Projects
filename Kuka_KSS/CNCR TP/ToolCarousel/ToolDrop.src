&ACCESS RVO9
&REL 13
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\Program\CNCR\CNCR_SUB\TOOLS 1 TO 6
DEF ToolDrop( )
;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 1.12.46
;************************************************
; Description: Program to have the robot drop it's
; currently held tool
;************************************************

MsgNotify("Tool drop in progress...", "AutoToolChange",,, nAutoToolChangeMsg+1, E_progNotifyMsgOpt)


CheckEOATooling(#SPINDLE)

SpindleOff ()      ;Process to shiut down the spindle

CowlUp()


RackSafe ()      ;Move robot to the rack safe position
ToolRackOpen()   ;Close tool rack
ToolrackMove (nToolHeld) ;Call tool changer to position for drop


WAIT FOR iToolPresent == FALSE
AboveAndAwayChanger();
AwayChanger()    ;Move robot to position horizontally away from tool changer

AtChanger()      ;Move robot to position in changer with tool in holder

ToolUnlock()      ;Run program to release tool from spindle

TRIGGER WHEN DISTANCE = 0 DELAY = 0 DO PulseAirKnife(5.0) PRIO = -1


AboveChanger()   ;Move robot to the position vertically away from changer

nToolHeld = 0      ;Set variable to 0, stating robot now holds no tool

ToolLock()        ;Lock spindle

MsgNotify("Tool drop complete...", "AutoToolChange",,, nAutoToolChangeMsg+2, E_progNotifyMsgOpt)

bRackSafe = TRUE ;Variable stating robot is now in a safe position above changer

END