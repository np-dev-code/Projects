;     Date: 25/09/23
;     Version: 1.12.38
;     Date: 25/09/23
;     Version: 1.13.46
;************************************************
; Description: Close tool rack lid.
;************************************************


oOpenToolRack = FALSE ;Cancel tool rack open 

WAIT SEC 0.25 ;Time delay

oCloseToolRack = TRUE ;Signal to close tool rack lid 

WAIT FOR (iToolRackClosed) ;Wait for tool rack closed signal 

END
