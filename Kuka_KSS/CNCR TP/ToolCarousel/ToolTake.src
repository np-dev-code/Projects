&ACCESS RVP
&REL 9
DEF ToolTake(_nNewTool:IN)
INT _nNewTool
;FOLD INI
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here
  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 0.13.46
;************************************************
; Description: Program to have the robot take 
; a new tool from the tool changer
;************************************************
;HOME ROBOT ONLY

CheckEOATooling(#SPINDLE)

HomeRobot();
;Check if the robot is holding the requested tool.
;If it holds the tool, update data and exit program.
;If not the Tool_Check() program is called to drop the currently held tool

MsgNotify("Tool take (%1) in progress...", "AutoToolChange",_nNewTool,, nAutoToolChangeMsg+3, E_progNotifyMsgOpt)

;FOLD TOOL CHECK
IF (nToolHeld == _nNewTool) THEN
    $TOOL = TOOL_DATA[_nNewTool]
    $ACT_TOOL = _nNewTool
    MsgNotify("Tool %1 is already in the spindle.", "AutoToolChange",_nNewTool,, nAutoToolChangeMsg+4, E_progNotifyMsgOpt)
    RETURN
ELSE
	ToolCheck()
ENDIF
;ENDFOLD

SpindleOff() ;Call program to turn off the spindle

ToolRackOpen()		 ;Close tool rack

CowlUp()

;If robot is in safe position continue, else move to rack safe position
IF (NOT bRackSafe) THEN
    RackSafe()
ELSE
    bRackSafe = FALSE
ENDIF

ToolrackMove(_nNewTool) ;Move tool changer to position on requested tool

WAIT FOR iToolPresent == TRUE
AboveChanger()        ;Move robot to position above tool changer

ToolUnlock()           ;Unlock spindle

TRIGGER WHEN DISTANCE = 1 DELAY = -4000  DO PulseAirKnife(5.0) PRIO = -1

AtChanger()           ;Move robot to position in tool changer, with tool in spindle

nToolHeld = _nNewTool     ;Update variable stating robot is now holding the new tool

ToolLock()             ;Lock the spindle

AwayChanger()         ;Move robot horizontally to position away from changer

AboveAndAwayChanger()
RackSafe()           ;Move robot to safe position near rack

ToolRackClose()		 ;Close tool rack

HomeRobot()       ;Return the robot to the home position

MsgNotify("Tool %1 collected successfully.", "AutoToolChange",_nNewTool,, nAutoToolChangeMsg+5, E_progNotifyMsgOpt)
END
