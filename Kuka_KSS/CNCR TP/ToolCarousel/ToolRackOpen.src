&ACCESS RVO6
&REL 5
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF ToolRackOpen( )
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 0.12.38
;     Date: 25/09/23
;     Version: 0.13.46
;************************************************
; Description: Open tool rack lid.
;************************************************


WAIT SEC 0

oCloseToolRack = FALSE ;Cancel tool rack close 

WAIT SEC 0.25 ;Time Delay

oOpenToolRack = TRUE ;Signal to open tool rack lid

WAIT FOR (iToolRackOpen) ;Wait for tool rack open signal 

END
