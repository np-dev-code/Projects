&ACCESS RVO6
&REL 69
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEFFCT BOOL ToolrackProg(_nProgIn:In)
DECL BOOL _bRetVal;
DECL INT _nProgIn;
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 0.12.46
;************************************************
; Description: Function to move the tool changer
;************************************************

MsgNotify("Tool rack moving to position %1...", "AutoToolChange",_nProgIn,, nAutoToolChangeMsg+11, E_progNotifyMsgOpt)

;Set start signal to FALSE and enable signal to TRUE
oToolrackStart = FALSE
oToolrackEnable = TRUE

;Reset tool rack if a fault has occured

IF (NOT iToolrackOk) THEN 
	oToolrackReset = TRUE
    WAIT SEC 1
    oToolrackReset = FALSE
ENDIF

;Output selected tool on data bits

oToolrackProgram = _nProgIn
WAIT SEC 0.3

;Read data bits into inverter

oToolrackSet = TRUE
WAIT SEC 0.3
oToolrackSet = FALSE

;Begin tool rack motion

nToolRackPosition = -1
oToolrackStart = TRUE
WAIT FOR (iToolrackComplete); OR (NOT iToolrackActive)

WAIT FOR (iToolrackInPosition)
WAIT SEC 0.2

;Set return value and use as result of the function

_bRetVal = iToolrackActive AND iToolrackComplete

oToolrackStart = FALSE
oToolrackEnable = FALSE

RETURN _bRetVal

ENDFCT