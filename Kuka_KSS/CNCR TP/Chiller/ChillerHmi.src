&ACCESS RVE
&REL 9
&COMMENT Ansteuerung Micromaster Frequenzumrichter
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\ExpertSubmit
DEF ChillerHmi( )

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 0.13.46
;************************************************
; Description: sps to control the tool rack hmi.
;************************************************

;If drop is pressed, call the ToolDrop() routine
IF (bHmiChillerOn) THEN
  MsgDialog(nHmiChillerOnAns,"The Chiller will now turn on.","Chiller",,,,,,,"Cancel","Continue", FALSE, nAutoToolChangeMsg + 12, E_spsMsgOpt)
   bHmiChillerOn = FALSE
ENDIF
       
IF (nHmiChillerOnAns == 1) THEN
   CWRITE($CMD,E_stat,E_mode,"RUN/R1/ChillerOn()")
    CWRITE($CMD,E_stat,E_mode,"STOP 1")
   nHmiChillerOnAns = 0
ENDIF

IF (bHmiChillerOff) THEN
  MsgDialog(nHmiChillerOffAns,"The Chiller will now turn off.","Chiller",,,,,,,"Cancel","Continue", FALSE, nAutoToolChangeMsg + 12, E_spsMsgOpt)
   bHmiChillerOff = FALSE
ENDIF
       
IF (nHmiChillerOffAns == 1) THEN
   CWRITE($CMD,E_stat,E_mode,"RUN/R1/ChillerOff()")
    CWRITE($CMD,E_stat,E_mode,"STOP 1")
   nHmiChillerOffAns = 0
ENDIF

IF (bHmiChillerReset) THEN
   ChillerReset()
ENDIF
END