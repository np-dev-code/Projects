&ACCESS RVO1
&REL 7
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF CeadInterrupt( )
;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 26/09/23
;     Version: 0.4.51
;************************************************
; Description: Interrupt to control what happens in
; the event of a fault.
;************************************************

BRAKE

ResetCead()

IF bRotationFlag THEN
   WAIT FOR iReadyForUse
ENDIF

bCeadInterrupt = FALSE

END
