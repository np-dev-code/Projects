&ACCESS RV
&REL 35
&COMMENT Ansteuerung Micromaster Frequenzumrichter
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\ExpertSubmit
DEF CeadConversion(  )
;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 26/09/23
;     Version: 0.5.51
;************************************************
; Description: sps control specific for the converting the
; Cead datatypes.
;************************************************

;ROBOT INPUTS 

;INTEGERS
nWarmUpTimer   = iWarmUpTimer                                 
nScrewTorque = iScrewTorque
;REALS
rHeatZone1Temp = IntToReal(iHeatZone1Temp,1)
rHeatZone2Temp = IntToReal(iHeatZone2Temp,1)
rHeatZone3Temp = IntToReal(iHeatZone3Temp,1)
rHeatZone4Temp = IntToReal(iHeatZone4Temp,1)
rExtruderScrewSpeed = IntToReal(iExtruderScrewSpeed,1)
rExtruderScrewUtil = IntToReal(iExtruderScrewUtil,1)
rExtruderScrewTorque = IntToReal(iExtruderScrewTorque,1)
rBed1AverageTemp = IntToReal(iBed1AverageTemp,1)
rBed2AverageTemp = IntToReal(iBed2AverageTemp,1)


;ROBOT OUTPUTS

;INTEGERS
oChangePelletSource = nChangePelletSource
;REALS										
oPumpTime = RealToInt(rPumpTime,1)
oShotSize = RealToInt(rShotSize,1)
oHeatZone1Set = RealToInt(rHeatZone1Set,1)
oHeatZone2Set = RealToInt(rHeatZone2Set,1)
oHeatZone3Set = RealToInt(rHeatZone3Set,1)
oHeatZone4Set = RealToInt(rHeatZone4Set,1)
oScrewSet_rpm = RealToInt(rScrewAdjusted_rpm,1)
oBed1Set = RealToInt(rBed1Set,1)
oBed2Set = RealToInt(rBed2Set,1)

END