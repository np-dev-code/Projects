&ACCESS RV1
&REL 7
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF SpindleInterrupt( )
;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 0.13.38
;************************************************
; Description: Interrup to control what happens in
; the event of a fault.
;************************************************
DECL BOOL _bSpindleState

;SET SPINDLE STATE 
_bSpindleState = bRequestSpindle

;Door is currently locked so stop robot process 

;turn spindle off

bRequestSpindle = FALSE

;halts robot motion 

BRAKE

;stops robot interpreter program 

;SET SPINDLE TO PREVIOUS STATE.
bRequestSpindle = _bSpindleState

IF (_bSpindleState== TRUE) THEN
WAIT FOR ($AUT OR $EXT)
ENDIF

WAIT FOR (oSpindleOn == _bSpindleState)

;Wait for 5 seconds to allow spindle to ramp up 

IF (oSpindleOn) THEN
   WAIT SEC 5
ENDIF   

bSpindleInterrupt = FALSE

END
