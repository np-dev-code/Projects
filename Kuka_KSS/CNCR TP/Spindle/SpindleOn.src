&ACCESS RVO1
&REL 42
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF SpindleOn( )

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 0.14.46
;************************************************
; Description: Routine to turn on the spindle
;************************************************

WAIT SEC 0

CheckEOATooling(#SPINDLE)


IF bRequestChiller == FALSE THEN
   ChillerOn()
ENDIF

WAIT FOR iToolLocked

;Turn spindle on
bRequestSpindle = TRUE

;Wait for inverter running
WAIT FOR (iInvRun)

WAIT SEC 5

MsgNotify("Spindle started...", "Spindle",,, nSpindleMsg + 5, E_progNotifyMsgOpt)

END
