&ACCESS RO
&REL 7
&COMMENT Ansteuerung Micromaster Frequenzumrichter
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\ExpertSubmit
DEF SpindleMsgs( )
; CNC ROBOTICS LTD submit programm
;(Roboter SPS)

;************************************************
;              CNC Robotics Ltd
;              www.cncrobotics.co.uk
;************************************************
;     Contact: helpdesk@cncrobotics.co.uk
;     Date: 25/09/23
;     Version: 0.13.46
;************************************************
; Description: sps for the inverer
;************************************************

DECL KrlMsg_t _msg
DECL KrlMsgPar_t _msgPar[3]
DECL KrlMsgOpt_t _msgOpt
DECL INT _nhandle

_msg = {modul[] "CNCR", Nr 002, msg_txt[] "Inverter Failure"}

;Ensure this is not being caused by an e-stop or operator safety
IF ((NOT iInvOK) AND ($AUT OR $EXT) AND ($ALARM_STOP) AND ($USER_SAF)) THEN
	IF (NOT bInvMessage) THEN
        _nhandle = Set_KrlMsg (#notify, _msg, _msgPar[], _msgOpt) 
	    bInvMessage = TRUE
	ENDIF
ELSE 
	bInvMessage = FALSE
ENDIF



END