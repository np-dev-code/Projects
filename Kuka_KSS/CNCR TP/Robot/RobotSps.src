IF $T1 THEN 
   oMode = 0;
ENDIF
IF $T2 THEN 
   oMode = 1;
ENDIF
IF $AUT THEN 
   oMode = 2;
ENDIF
IF $EXT THEN 
   oMode = 3;
ENDIF

bDoorFault = ($AUT OR $EXT) AND (NOT iDoorSignal)

END