;SYSTEM HMI PAGE
    

IF (bHmiCowlUp) THEN
   bHmiCowlUp = FALSE
   oHoodDown = FALSE
   oHoodUp = TRUE
ENDIF

IF (bHmiCowlDown) THEN
   bHmiCowlDown = FALSE
   oHoodUp = FALSE
   oHoodDown = TRUE
ENDIF

END


;ENDFOLD (USER SUBROUTINE)